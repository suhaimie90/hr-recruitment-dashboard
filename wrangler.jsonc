{
  // Cloudflare Workers config. `npx wrangler deploy` reads this.
  //
  // GAS_URL and GAS_TOKEN are deliberately NOT listed under "vars" —
  // they are Secrets, set in the dashboard (Worker → Settings →
  // Variables and Secrets) or via `npx wrangler secret put NAME`.
  // Anything in "vars" is committed to git and visible in the
  // dashboard in plain text.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hr-recruitment",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  "assets": {
    // Vite's build output. Must match "outputDirectory" / build settings.
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request hits the Worker, which then routes /api/gas itself
    // and serves everything else from assets. Explicit beats relying on
    // asset-router precedence.
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  }
}
