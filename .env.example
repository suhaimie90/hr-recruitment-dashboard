# Copy to .env.local for local development.
# In production these live in the Cloudflare Pages project settings
# (Settings -> Variables and secrets), never in the repo.
#
# No VITE_ prefix, on purpose: prefixed variables are inlined into the
# client bundle, which would publish these to every visitor.

# ── Supabase (the current backend, served at /api/data) ────

# Project URL, from Supabase -> Settings -> API.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# service_role key, from Supabase -> Settings -> API. Bypasses row
# level security — never send this to the browser.
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"

# ── Google OAuth (Sign in with Google, served at /api/auth/*) ──

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID. Authorized redirect URI must be
# "<your deployed origin>/api/auth/callback" (and "http://localhost:3000
# /api/auth/callback" for local dev).
GOOGLE_CLIENT_ID="replace-with-your-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-oauth-client-secret"

# Signs the session cookie issued after Google sign-in. Any change
# invalidates every existing session. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# ── Legacy Apps Script proxy (still deployed at /api/gas as a
#    rollback path — see functions/api/gas.ts) ────────────────

# Apps Script web app deployment URL (must end in /exec)
GAS_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Must match DASHBOARD_TOKEN in the Apps Script Config.gs exactly.
# Generate one with: openssl rand -hex 32
GAS_TOKEN="replace-with-a-long-random-string"
