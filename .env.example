# Copy to .env.local for local development.
# In production these live in the Cloudflare Pages project settings
# (Settings -> Variables and secrets), never in the repo.
#
# No VITE_ prefix, on purpose: prefixed variables are inlined into the
# client bundle, which would publish these to every visitor.

# ── Supabase (the current backend, served at /api/data) ────

# Project URL, from Supabase -> Settings -> API.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# service_role key, from Supabase -> Settings -> API. Bypasses row
# level security — never send this to the browser.
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"

# ── Public portfolio demo login ─────────────────────────

# These intentionally match the credentials prefilled on LoginScreen.
# The password is public; isolation and synthetic data are the security
# boundary. The email must exist as an active row in Supabase `users`.
DEMO_EMAIL="demo@talentflow.app"
DEMO_PASSWORD="TalentFlowDemo!"
DEMO_MODE="true"

# Signs the HS256 JWT stored in the HttpOnly session cookie. This value
# is private. Any change invalidates every existing session. Generate:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# ── Optional external integrations ─────────────────────
# These are not called while DEMO_MODE=true. Leave them unset for the
# portfolio deployment. They exist only for a non-demo deployment that
# intentionally enables Drive resume uploads and Calendar sync.

# Apps Script web app deployment URL (must end in /exec)
GAS_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Must match DASHBOARD_TOKEN in the Apps Script Config.gs exactly.
# Generate one with: openssl rand -hex 32
GAS_TOKEN="replace-with-a-long-random-string"
